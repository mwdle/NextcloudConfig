[Unit]
Wants=nextcloud-cache.service
After=nextcloud-cache.service
Wants=nextcloud-db.service
After=nextcloud-db.service

[Container]
Image=docker.io/library/nextcloud:35.0.2-apache@sha256:89af7ee7a96ff5e9668280566209268ae6b2d02327f6ef6d56f6d68228cf9431
ContainerName=nextcloud

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Secret=nextcloud_admin_password,target=nextcloud_password,uid=33,gid=33,mode=0400
Secret=nextcloud_admin_username,target=nextcloud_username,uid=33,gid=33,mode=0400
Secret=nextcloud_db_password,target=db_password,uid=33,gid=33,mode=0400
Secret=nextcloud_db_username,target=db_username,uid=33,gid=33,mode=0400
Secret=lab_smtp_password,target=smtp_password,uid=33,gid=33,mode=0400
Secret=lab_smtp_username,type=env,target=SMTP_NAME
Secret=nextcloud_mail_domain,type=env,target=MAIL_DOMAIN

Timezone=local

Environment=APACHE_BODY_LIMIT=0
Environment=MAIL_FROM_ADDRESS=noreply
Environment=NEXTCLOUD_ADMIN_PASSWORD_FILE=/run/secrets/nextcloud_password
Environment=NEXTCLOUD_ADMIN_USER_FILE=/run/secrets/nextcloud_username
Environment=NEXTCLOUD_TRUSTED_DOMAINS=cloud.mwdle.com
Environment=OVERWRITEHOST=cloud.mwdle.com
Environment=OVERWRITEPROTOCOL=https
Environment=OVERWRITECLIURL=https://cloud.mwdle.com
Environment=PHP_UPLOAD_LIMIT=32G
Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_HOST=nextcloud-db
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db_password
Environment=POSTGRES_USER_FILE=/run/secrets/db_username
Environment=REDIS_HOST=nextcloud-cache
Environment=SMTP_HOST=heracles.mxrouting.net
Environment=SMTP_PORT=465
Environment=SMTP_PASSWORD_FILE=/run/secrets/smtp_password
Environment=SMTP_SECURE=ssl
Environment=TRUSTED_PROXIES=10.89.0.0/16

Volume=%h/containers/nextcloud/data:/var/www/html:U,z
Volume=nextcloud-tmp:/tmp:U,z
# https://help.nextcloud.com/t/nextcloud-containerized-on-synology-with-changed-uid-gid/181714/4
Volume=./overrides/redis-session.ini:/usr/local/etc/php/conf.d/redis-session.ini:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/var/run/apache2:noexec,nosuid,size=32M

User=www-data
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Sysctl=net.ipv4.ip_unprivileged_port_start=80

HealthStartupCmd=curl -fSs 'http://localhost/status.php' | grep '"installed":true' | grep '"maintenance":false' | grep '"needsDbUpgrade":false' || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=curl -fSs 'http://localhost/status.php' | grep '"installed":true' | grep '"maintenance":false' | grep '"needsDbUpgrade":false' || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=3G
PidsLimit=256

[Service]
CPUQuota=300%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/nextcloud/data

[Install]
WantedBy=default.target
