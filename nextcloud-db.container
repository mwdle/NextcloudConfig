[Container]
Image=docker.io/library/postgres:18.6-alpine3.23@sha256:885cf05d376c7cf27afef02073e6bdac3841252537f16e244fd1c1e6a7c99fb1
ContainerName=nextcloud-db

Network=nextcloud-db.network

Secret=nextcloud_db_password,target=db_password,uid=1000,gid=1000,mode=0400
Secret=nextcloud_db_username,target=db_username,uid=1000,gid=1000,mode=0400

Environment=POSTGRES_DB=nextcloud
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db_password
Environment=POSTGRES_USER_FILE=/run/secrets/db_username
Environment=TZ=America/Denver

Volume=%h/containers/nextcloud/database:/var/lib/postgresql:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/dev/shm:noexec,nosuid,size=256M
Tmpfs=/var/run/postgresql:noexec,nosuid,size=32M

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=sh -c 'PGUSER=$$(cat /run/secrets/db_username) pg_isready -d nextcloud || exit 1'
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=sh -c 'PGUSER=$$(cat /run/secrets/db_username) pg_isready -d nextcloud || exit 1'
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=512M
PidsLimit=100

[Service]
CPUQuota=100%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/nextcloud/database

[Install]
WantedBy=default.target
