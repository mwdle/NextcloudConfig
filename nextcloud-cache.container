[Container]
Image=docker.io/library/redis:8.10.3-alpine3.23@sha256:21090af93f8324db2f0f0f4f38a7c60369d47d917e000c3423d89d2ae2883537
ContainerName=nextcloud-cache

Network=nextcloud-cache.network

Timezone=local

ReadOnly=true
ReadOnlyTmpfs=false

User=redis
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=redis-server --save "" --maxmemory 192mb --maxmemory-policy allkeys-lru

HealthStartupCmd=redis-cli ping
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=redis-cli ping
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=100

[Service]
CPUQuota=25%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
