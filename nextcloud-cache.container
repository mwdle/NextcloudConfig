[Container]
Image=docker.io/library/redis:8.10.2-alpine3.23@sha256:9f8d2d789b9a1d1e3f283f979aa9cbf393373806472e1ccd460e2f9c869b833b
ContainerName=nextcloud-cache

Network=nextcloud-cache.network

Timezone=local

ReadOnly=true
ReadOnlyTmpfs=false

User=redis
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=redis-server --save "" --maxmemory 192mb --maxmemory-policy allkeys-lru

HealthStartupCmd=redis-cli ping
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=redis-cli ping
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=100

[Service]
CPUQuota=25%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
