[Container]
Image=docker.io/library/redis:8.10.2-alpine3.23@sha256:0bf6577d7774e592b29d093e3ac9390eb91e13d72c21e506afce736de5e0eeb0
ContainerName=nextcloud-cache

Network=nextcloud-cache.network

Timezone=local

ReadOnly=true
ReadOnlyTmpfs=false

User=redis
UserNS=auto
NoNewPrivileges=true
DropCapability=all

Exec=redis-server --save "" --maxmemory 192mb --maxmemory-policy allkeys-lru

HealthStartupCmd=redis-cli ping
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=redis-cli ping
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=100

[Service]
CPUQuota=25%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
