[Unit]
Requires=nextcloud.service
After=nextcloud.service

[Container]
Image=docker.io/library/nextcloud:35.0.2-apache@sha256:a588aa5353703b44106a6129adaaf7bf22521b7a4754f9f529b3228d6aa390c5
ContainerName=nextcloud-cron

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Volume=%h/containers/nextcloud/data:/var/www/html:z
Volume=nextcloud-tmp:/tmp:z

ReadOnly=true
ReadOnlyTmpfs=false

User=www-data
UserNS=container:nextcloud
NoNewPrivileges=true
DropCapability=all

Entrypoint=/bin/sh
Exec=-c 'while true; do php -f /var/www/html/cron.php; sleep 300; done'

Memory=128M
PidsLimit=100

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
