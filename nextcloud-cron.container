[Unit]
Requires=nextcloud.service
After=nextcloud.service

[Container]
Image=docker.io/library/nextcloud:35.0.1-apache@sha256:8f2f0e93aca5e9457019933936dea1f313052e72c696b4aecb31580a208b859f
ContainerName=nextcloud-cron

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Volume=%h/containers/nextcloud/data:/var/www/html
Volume=nextcloud-tmp:/tmp

ReadOnly=true
ReadOnlyTmpfs=false

User=www-data
UserNS=container:nextcloud
NoNewPrivileges=true
DropCapability=all

Entrypoint=/bin/sh
Exec=-c 'while true; do php -f /var/www/html/cron.php; sleep 300; done'

Memory=128M
PidsLimit=100

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
