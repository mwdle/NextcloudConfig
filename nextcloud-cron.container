[Unit]
Requires=nextcloud.service
After=nextcloud.service

[Container]
Image=docker.io/library/nextcloud:35.0.1-apache@sha256:f4e0ee28ac9e54cad6e04e148489d79a609acba86dfbff69c8f666d50f96e414
ContainerName=nextcloud-cron

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Volume=%h/containers/nextcloud/data:/var/www/html
Volume=nextcloud-tmp:/tmp

ReadOnly=true
ReadOnlyTmpfs=false

User=www-data
UserNS=container:nextcloud
NoNewPrivileges=true
DropCapability=all

Entrypoint=/bin/sh
Exec=-c 'while true; do php -f /var/www/html/cron.php; sleep 300; done'

Memory=128M
PidsLimit=100

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
