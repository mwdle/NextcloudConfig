[Unit]
Requires=nextcloud.service
After=nextcloud.service

[Container]
Image=docker.io/library/nextcloud:35.0.2-apache@sha256:89af7ee7a96ff5e9668280566209268ae6b2d02327f6ef6d56f6d68228cf9431
ContainerName=nextcloud-cron

Network=nextcloud.network
Network=nextcloud-cache.network
Network=nextcloud-db.network

Timezone=local

Volume=%h/containers/nextcloud/data:/var/www/html:z
Volume=nextcloud-tmp:/tmp:z

ReadOnly=true
ReadOnlyTmpfs=false

User=www-data
UserNS=container:nextcloud
NoNewPrivileges=true
DropCapability=all

Entrypoint=/bin/sh
Exec=-c 'while true; do php -f /var/www/html/cron.php; sleep 300; done'

Memory=128M
PidsLimit=100

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
